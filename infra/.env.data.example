# 데이터 서버(EC2-B)용 환경변수 예시.
#   cd infra && cp .env.data.example .env && chmod 600 .env
# .env는 서버에만 두고 절대 커밋·공유하지 않는다.

# 포트(ES 9200·postgres 5432·redis 6379·kafka 9092)를 열 이 서버 내부 IP.
# Kafka가 앱 서버에 알려 주는 접속 주소로도 쓰인다. (예전 이름 ES_BIND_IP)
DATA_BIND_IP=

# 이 서버 Alloy가 로그·지표를 보낼 앱 서버(EC2-A) 내부 IP. 앱 서버 .env의 MONITORING_BIND_IP와 같은 값
MONITORING_HOST=

# ES 기본 관리자(elastic) 비밀번호
ELASTIC_PASSWORD=

# ES 계정 비밀번호.
# market_es_user: market 앱의 상품 담당자용, products* 인덱스 읽기·쓰기. EC2-A의 .env에도 같은 값을 넣는다
MARKET_ES_PASSWORD=
# readonly_es_user: 팀원 확인용, 읽기만
READONLY_ES_PASSWORD=

# postgres. 앱 서버 .env와 같은 값을 넣는다.
# 앱 서버의 데이터 볼륨을 복사해 오므로 계정·비밀번호는 이미 DB 안에 있다. 아래 값은 빈 DB로 새로 만들 때만 쓰인다
DB_NAME=palette
DB_USERNAME=palette
DB_PASSWORD=
MEMBER_DB_PASSWORD=
MARKET_DB_PASSWORD=
PAYMENT_DB_PASSWORD=
SETTLEMENT_DB_PASSWORD=
DELIVERY_DB_PASSWORD=
NOTIFICATION_DB_PASSWORD=
AI_DB_PASSWORD=
READONLY_DB_PASSWORD=

# redis 비밀번호. 앱 서버 .env의 REDIS_PASSWORD와 같은 값. 생성: openssl rand -hex 24
# (따옴표·공백이 없는 값을 쓴다. 컨테이너 안에서 명령줄로 넘기기 때문이다)
REDIS_PASSWORD=
