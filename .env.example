# 이 파일을 복사해 .env로 만들고 값을 채운다. .env는 Git에 올리지 않는다.

# 인증 메일 발송 계정 (Gmail 앱 비밀번호, 공백 없이 16자)
MAIL_USERNAME=
MAIL_PASSWORD=

# JWT 서명 키 (Base64, 32바이트 이상). 로컬 값은 팀에 따로 공유된 값을 넣는다. 없으면 앱이 뜨지 않는다.
JWT_SECRET=

# 서비스 간 호출(/internal/**) 인증 키. 로컬 값은 팀에 따로 공유된 값을 넣는다. 없으면 앱이 뜨지 않는다.
INTERNAL_API_KEY=

# 정산 계좌번호 암호화 키. 로컬 값은 팀에 따로 공유된 값을 넣는다. 없으면 앱이 뜨지 않는다.
ACCOUNT_ENCRYPTION_PASSWORD=
ACCOUNT_ENCRYPTION_SALT=

# 개발용 시드 회원(1 관리자, 2 판매자, 3 구매자) 비밀번호. 비워 두면 시드를 넣지 않는다. 운영 환경에는 넣지 않는다.
MEMBER_SEED_PASSWORD=

# market이 결제를 부르는 payment-service 주소(주문 결제·결제 취소·결제 내역). 로컬은 기본값(http://localhost:8083)을 쓴다. 바꿀 때만 주석을 푼다
# PAYMENT_SERVICE_URL=

# 토스페이먼츠 시크릿 키. 로컬은 테스트 키(test_gsk_...)를 쓴다.
TOSS_SECRET_KEY=

# 헥토파이낸셜(충전 두 번째 PG) 상점 ID·암호화 키·해시 키. 로컬은 헥토 문서의 테스트베드 공용 값(인증 분리 상점)을 쓴다. 비워 두면 헥토 호출만 실패한다.
HECTO_MCHT_ID=
HECTO_AES_KEY=
HECTO_HASH_KEY=

# 카카오 로그인(계정 연결). 카카오 개발자 콘솔의 REST API 키와 Client Secret. 비워 두면 카카오 로그인만 실패한다.
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
# 프론트 콜백 화면 주소. 로컬은 기본값(http://localhost:5173/oauth/kakao/callback)을 쓴다. 빈 값으로 두면 기본값 대신 빈 주소가 들어가므로 바꿀 때만 주석을 푼다
# KAKAO_REDIRECT_URI=

# Delivery Tracker(배송 조회 API). 키는 팀에 공유된 값을 넣는다. 없으면 delivery가 뜨지 않는다.
DELIVERY_TRACKER_CLIENT_ID=
DELIVERY_TRACKER_CLIENT_SECRET=
DELIVERY_TRACKER_CALLBACK_BASE_URL=http://localhost:8085/webhooks/delivery-tracker

# 32자 이상. 생성: openssl rand -hex 32
DELIVERY_TRACKER_CALLBACK_TOKEN=

# 웹훅 등록·재등록을 켤지(기본 true). 로컬은 http 콜백 주소를 local 프로필(allowInsecureCallback=true)이 허용한다.
# 끄면 확인 워커·안전망(발송 2일 뒤 06:00)만 돈다. 실제 API에 웹훅을 걸고 싶지 않으면 false로 둔다
DELIVERY_TRACKER_WEBHOOK_ENABLED=false

# OpenAI API 키 (ai-service의 추천·FAQ 임베딩, 챗봇 답변). 로컬 값은 팀에 따로 공유된 값을 넣는다. 없으면 ai-service가 뜨지 않는다.
OPENAI_API_KEY=
