# 이 파일을 복사해 .env로 만들고 값을 채운다. .env는 Git에 올리지 않는다.

# 인증 메일 발송 계정 (Gmail 앱 비밀번호, 공백 없이 16자)
MAIL_USERNAME=
MAIL_PASSWORD=

# JWT 서명 키 (Base64, 32바이트 이상). 로컬 값은 팀에 따로 공유된 값을 넣는다. 없으면 앱이 뜨지 않는다.
JWT_SECRET=

# 정산 계좌번호 암호화 키. 로컬 값은 팀에 따로 공유된 값을 넣는다. 없으면 앱이 뜨지 않는다.
ACCOUNT_ENCRYPTION_PASSWORD=
ACCOUNT_ENCRYPTION_SALT=

# 개발용 시드 회원(1 관리자, 2 판매자, 3 구매자) 비밀번호. 비워 두면 시드를 넣지 않는다. 운영 환경에는 넣지 않는다.
MEMBER_SEED_PASSWORD=

# 토스페이먼츠 시크릿 키. 로컬은 테스트 키(test_gsk_...)를 쓴다.
TOSS_SECRET_KEY=
