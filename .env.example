# 이 파일을 복사해 .env로 만들고 값을 채운다. .env는 Git에 올리지 않는다.

# 인증 메일 발송 계정 (Gmail 앱 비밀번호, 공백 없이 16자)
MAIL_USERNAME=
MAIL_PASSWORD=

# JWT 서명 키 (Base64, 생성: openssl rand -base64 32). 로컬에서는 줄째로 빼 두면 개발용 기본값을 쓴다. 빈 값(JWT_SECRET=)으로 두면 앱이 뜨지 않는다.
# JWT_SECRET=

# 개발용 시드 회원(1 관리자, 2 판매자, 3 구매자) 비밀번호. 비워 두면 시드를 넣지 않는다. 운영 환경에는 넣지 않는다.
MEMBER_SEED_PASSWORD=

# 토스페이먼츠 시크릿 키. 로컬은 테스트 키(test_gsk_...)를 쓴다.
TOSS_SECRET_KEY=
