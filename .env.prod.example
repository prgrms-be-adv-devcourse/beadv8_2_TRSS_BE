# 운영 서버용 환경변수 예시. 서버에서 이 파일을 복사해 compose.prod.yaml 옆에 .env로 만들고 값을 채운다.
#   cp .env.prod.example .env && chmod 600 .env
# .env는 서버에만 두고 절대 커밋·공유하지 않는다. 로컬 개발용 값과 다른 값을 쓴다.

# DB (postgres 컨테이너 생성과 앱 접속에 같이 쓰인다. DB_HOST·REDIS_HOST는 compose가 넣는다)
DB_NAME=palette
DB_USERNAME=palette
DB_PASSWORD=

# JWT 서명 키 (Base64, 32바이트 이상). 생성: openssl rand -base64 32
JWT_SECRET=

# 정산 계좌번호 암호화 키. 한 번 정하면 바꾸지 않는다(바꾸면 저장된 계좌번호를 못 읽는다).
#   password: openssl rand -base64 32 / salt: openssl rand -hex 8
ACCOUNT_ENCRYPTION_PASSWORD=
ACCOUNT_ENCRYPTION_SALT=

# 인증 메일 발송 계정 (Gmail 앱 비밀번호)
MAIL_USERNAME=
MAIL_PASSWORD=

# 토스페이먼츠 시크릿 키 (부트캠프 기간에는 테스트 키 test_gsk_...)
TOSS_SECRET_KEY=

# 프론트 주소(쉼표로 구분). 프론트 배포 주소가 정해지면 바꾼다.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Refresh Token 쿠키. HTTPS 적용 전에는 false, 적용 후 true.
# 프론트·백엔드 도메인이 다르면 SameSite=None (Secure=true 필수)
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=Lax

# 시드 회원(1 관리자, 2 판매자, 3 구매자) 비밀번호. 비워 두면 시드를 넣지 않는다.
# 주의: 비우면 1번 관리자가 없어서 수수료 이체(custom.payment.adminMemberId=1)가 실패한다. 운영 관리자 생성 방식은 팀에서 정한다.
MEMBER_SEED_PASSWORD=

# 상품 이미지 저장소: local | s3. 빈 값으로 두면 어느 저장소도 켜지지 않아 앱이 뜨지 않으니 둘 중 하나를 적는다.
# local은 컨테이너 안 폴더라 배포할 때마다 이미지가 사라진다.
# s3는 S3 저장소 구현이 머지된 뒤에만 넣는다. 구현 없이 s3로 두면 저장소가 없어 앱이 뜨지 않는다.
PRODUCT_IMAGE_STORAGE=local
# S3 버킷 설정 (storage가 s3일 때만 쓴다). 인증은 EC2에 붙인 IAM 역할로 하므로 액세스 키는 넣지 않는다.
PRODUCT_IMAGE_S3_BUCKET=
PRODUCT_IMAGE_S3_REGION=ap-northeast-2
PRODUCT_IMAGE_S3_BASE_URL=

# 로그 모니터링(Grafana). 셋 중 하나라도 비어 있으면 compose가 시작되지 않는다.
# Grafana 관리자(admin) 비밀번호. 생성: openssl rand -base64 24
GRAFANA_ADMIN_PASSWORD=
# 브라우저로 Grafana를 여는 주소(nginx /grafana/ 경로). 끝의 /grafana/까지 적는다. Slack 알림 링크도 이 주소로 만들어진다.
GRAFANA_ROOT_URL=http://{서버 IP 또는 도메인}/grafana/
# 앱 ERROR 로그를 팀 채널에 보내는 Slack 앱(Team2 Alert)의 Bot User OAuth Token (xoxb-...)
# 받을 채널은 monitoring/grafana/provisioning/alerting/slack.yaml의 recipient에 적는다
SLACK_BOT_TOKEN=
